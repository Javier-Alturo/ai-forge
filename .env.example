# Copia este archivo a .env y ajusta valores.
# cp .env.example .env   (Linux / macOS)
# copy .env.example .env (Windows)

# local (Ollama, default) | cloud (Anthropic)
LLM_PROVIDER=local

OLLAMA_MODEL=qwen2.5:14b
OLLAMA_BASE_URL=http://localhost:11434

# --- Modo cloud (descomenta y rellena) ---
# Interruptor maestro: sin AIFORGE_ALLOW_CLOUD=1 ningún prompt sale a la nube,
# aunque LLM_PROVIDER=cloud o model_router.allow_cloud_fallback=true.
# AIFORGE_ALLOW_CLOUD=1
# LLM_PROVIDER=cloud
# ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Model Context Protocol (MCP), opcional ---
# MCP_DISABLED=1
# MCP_SERVERS_JSON={"demo":{"transport":"stdio","command":"python","args":["scripts/mcp_demo_server.py"]}}
# MCP_SERVERS_CONFIG=mcp_servers.json
# MCP_TOOL_NAME_PREFIX=true

# --- Google OAuth2 (Gmail + Calendar) ---
# Descarga OAuth "Desktop" JSON de Google Cloud Console como credentials.json
# o define rutas absolutas:
# GOOGLE_OAUTH_CREDENTIALS=credentials.json
# GOOGLE_OAUTH_TOKEN=token.json
# El primer uso abre el navegador para autorizar y crea token.json.

# --- Voz (Whisper local) ---
# WHISPER_MODEL=base
# VOICE_SILENCE_RMS=0.012

# --- Imágenes (Stable Diffusion) ---
# SD_MODEL_ID=runwayml/stable-diffusion-v1-5
# IMAGE_OUTPUT_DIR=outputs
# SD_SEED=42

# --- GitHub (PyGithub) ---
# GITHUB_TOKEN=ghp_...

# --- Memoria Chroma + RAG (sentence-transformers, mismo modelo por defecto) ---
# MEMORY_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_TOP_K=6

# --- Computer use (visión vía Ollama) ---
# OLLAMA_VISION_MODEL=llava
# ollama pull llava

# --- Obsidian Agent ---
# OBSIDIAN_VAULT_PATH=C:/Users/<tu-usuario>/Documents/ObsidianVault

# --- Seguridad de agentes locales ---
# Carpetas a las que el File Agent puede acceder (separadas por ";" en Windows, ":" en Linux).
# Por defecto solo data/agent_workspace. Credenciales (.env, token*.json, .ssh...) siempre bloqueadas.
# AIFORGE_FILE_ROOTS=C:/ruta/a/mis/documentos
# Computer Use: por defecto solo puede ver la pantalla. Para permitir clic/teclado/abrir apps:
# AIFORGE_ALLOW_COMPUTER_USE=1
# AIFORGE_ALLOWED_APPS=notepad,calc,mspaint
